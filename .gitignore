dist/
*.tar.gz
*.log
*.pid
tmp/

# Secrets and local overrides
.env
.env.*
!.env.example

# Backups made by `tropa init` when replacing an old AGENTS.md
*.bak-*

# Editor and OS clutter
.DS_Store
.vscode/
.idea/
*.swp
*~
