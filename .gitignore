# Dependencies
node_modules/

# AI-IRC runtime data (SQLite DB, WAL files) and local TTS cache
server/data/
*.db
*.db-shm
*.db-wal
*.sqlite
.incoming-tts/

# Python
__pycache__/
*.py[cod]

# Kit runtime state (only created if the kit is run in place)
